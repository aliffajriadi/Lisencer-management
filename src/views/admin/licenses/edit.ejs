<%
  var title = 'Edit Lisensi #' + license.id;
  var currentPage = 'licenses';
  function fmtDateInput(d) {
    if (!d) return '';
    var dt = new Date(d);
    return dt.toISOString().slice(0, 16);
  }
  function fmtDate(d) {
    if (!d) return '-';
    return new Date(d).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });
  }
  var isRevoked = license.revoked;
  var isExpired = !isRevoked && new Date(license.expiresAt) <= new Date();
  var isActive  = !isRevoked && !isExpired;

  var body = `
    <div class="admin-page-header">
      <div>
        <div class="admin-page-title">Edit Lisensi</div>
        <div class="text-muted text-sm">#${ license.id } — ${ license.username } / ${ license.scriptType.code }</div>
      </div>
      <a href="/admin/licenses" class="btn btn-ghost btn-sm">← Kembali</a>
    </div>

    ${ error ? `<div class="alert alert-error">${ error }</div>` : '' }
    ${ success ? `<div class="alert alert-success">${ success }</div>` : '' }

    <!-- Info block -->
    <div style="background:var(--c-surface);border:1px solid var(--c-border);border-radius:4px;padding:1rem 1.25rem;margin-bottom:1.5rem;">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:0.75rem;">
        <div>
          <div class="text-xs text-muted" style="text-transform:uppercase;letter-spacing:0.08em;margin-bottom:0.2rem;">Username</div>
          <div class="text-mono">${ license.username }</div>
        </div>
        <div>
          <div class="text-xs text-muted" style="text-transform:uppercase;letter-spacing:0.08em;margin-bottom:0.2rem;">Script</div>
          <div class="text-mono">${ license.scriptType.code } — ${ license.scriptType.name }</div>
        </div>
        <div>
          <div class="text-xs text-muted" style="text-transform:uppercase;letter-spacing:0.08em;margin-bottom:0.2rem;">Expired</div>
          <div class="text-mono">${ fmtDate(license.expiresAt) }</div>
        </div>
        <div>
          <div class="text-xs text-muted" style="text-transform:uppercase;letter-spacing:0.08em;margin-bottom:0.2rem;">Status</div>
          <span class="badge badge-${ isRevoked ? 'revoked' : isExpired ? 'expired' : 'active' }">${ isRevoked ? 'Revoked' : isExpired ? 'Expired' : 'Aktif' }</span>
        </div>
        <div>
          <div class="text-xs text-muted" style="text-transform:uppercase;letter-spacing:0.08em;margin-bottom:0.2rem;">PIN Management</div>
          <div class="text-mono" style="color:var(--c-accent); font-weight:600;">${ license.managementPin || '—' }</div>
        </div>
      </div>
    </div>

    <!-- Edit expired -->
    <div class="section-title">Override Tanggal Expired</div>
    <form method="POST" action="/admin/licenses/${ license.id }" class="form-block">
      <input type="hidden" name="action" value="update_expires">
      <div class="form-group" style="max-width:280px">
        <label for="edit-expires">Tanggal & Waktu Baru</label>
        <input type="datetime-local" name="expiresAt" id="edit-expires" value="${ fmtDateInput(license.expiresAt) }">
      </div>
      <button type="submit" class="btn btn-primary btn-sm">Simpan Perubahan</button>
    </form>

    <!-- Revoke / Unrevoke -->
    <div class="section-title">Revoke / Aktifkan</div>
    <div class="flex gap-2 items-center">
      ${ !isRevoked ? `
        <form method="POST" action="/admin/licenses/${ license.id }" onsubmit="return confirm('Yakin revoke lisensi ini?')">
          <input type="hidden" name="action" value="revoke">
          <button type="submit" class="btn btn-danger btn-sm">Revoke Lisensi</button>
        </form>
        <span class="text-xs text-muted">User tidak bisa pakai script setelah di-revoke.</span>
      ` : `
        <form method="POST" action="/admin/licenses/${ license.id }">
          <input type="hidden" name="action" value="unrevoke">
          <button type="submit" class="btn btn-primary btn-sm">Un-revoke (Aktifkan Kembali)</button>
        </form>
        <span class="text-xs text-muted">Status akan kembali aktif (jika belum expired).</span>
      ` }
    </div>

    <!-- Ganti Username (Admin) -->
    <div class="section-title" style="margin-top:1.5rem;">Ganti Username</div>
    <form method="POST" action="/admin/licenses/${ license.id }/change-username"
      onsubmit="return confirm('Yakin ganti username \\'${ license.username }\\' ke username baru?')">
      <div class="form-group" style="max-width:320px;margin-bottom:0.75rem;">
        <label for="admin-new-username">Username Baru</label>
        <input type="text" name="newUsername" id="admin-new-username" class="mono-input"
          placeholder="username_baru" autocomplete="off" spellcheck="false">
      </div>
      <button type="submit" class="btn btn-primary btn-sm">Ganti Username</button>
      <span class="text-xs text-muted" style="margin-left:0.5rem;">Perubahan akan dicatat di log.</span>
    </form>

    <div style="margin-top:1rem;">
      <a href="/admin/username-changes" class="text-sm text-muted">↪ Lihat riwayat ganti username →</a>
    </div>
  `;
%>
<%- include('../../layouts/admin', { title, currentPage, admin, body }) %>
