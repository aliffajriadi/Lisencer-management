<%
  var title = 'Kelola Lisensi';
  var currentPage = 'licenses';
  function fmtDate(d) {
    if (!d) return '-';
    return new Date(d).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' });
  }
  function licStatus(lic) {
    if (lic.revoked) return 'revoked';
    if (new Date(lic.expiresAt) <= now) return 'expired';
    return 'active';
  }
  function daysLeft(exp) { return Math.max(0, Math.ceil((new Date(exp) - new Date()) / 86400000)); }

  // Build pagination URL helper
  function pageUrl(p) {
    var params = new URLSearchParams();
    if (filters.search) params.set('search', filters.search);
    if (filters.script) params.set('script', filters.script);
    if (filters.status) params.set('status', filters.status);
    params.set('page', p);
    return '/admin/licenses?' + params.toString();
  }

  var body = `
    <div class="admin-page-header">
      <div class="admin-page-title">Lisensi</div>
    </div>

    <!-- Filter bar -->
    <form method="GET" action="/admin/licenses">
      <div class="filter-bar">
        <div class="form-group">
          <label>Cari Username</label>
          <input type="text" name="search" value="${ filters.search || '' }" placeholder="username...">
        </div>
        <div class="form-group">
          <label>Script</label>
          <select name="script">
            <option value="">Semua</option>
            ${ scriptTypes.map(st => `<option value="${ st.code }" ${ filters.script === st.code ? 'selected' : '' }>${ st.code }</option>`).join('') }
          </select>
        </div>
        <div class="form-group">
          <label>Status</label>
          <select name="status">
            <option value="">Semua</option>
            <option value="active" ${ filters.status === 'active' ? 'selected' : '' }>Aktif</option>
            <option value="expired" ${ filters.status === 'expired' ? 'selected' : '' }>Expired</option>
            <option value="revoked" ${ filters.status === 'revoked' ? 'selected' : '' }>Revoked</option>
          </select>
        </div>
        <div class="form-group" style="flex:0">
          <label>&nbsp;</label>
          <button type="submit" class="btn btn-ghost">Filter</button>
        </div>
      </div>
    </form>

    <div class="text-muted text-xs mb-1">
      ${ pagination.total } lisensi ditemukan &mdash; halaman ${ pagination.page } dari ${ pagination.totalPages }
    </div>

    <div class="table-wrap mb-2">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Username</th>
            <th>Script</th>
            <th>Expired</th>
            <th>Sisa</th>
            <th>PIN Management</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          ${ licenses.length === 0 ? '<tr><td colspan="8" style="text-align:center;padding:1.5rem" class="text-muted text-sm">Tidak ada data</td></tr>' :
            licenses.map(lic => {
              const st = licStatus(lic);
              const label = st === 'active' ? 'Aktif' : st === 'expired' ? 'Expired' : 'Revoked';
              const days = st === 'active' ? daysLeft(lic.expiresAt) + ' hr' : '—';
              return `
                <tr>
                  <td class="td-mono text-muted">#${ lic.id }</td>
                  <td class="td-mono">${ lic.username }</td>
                  <td class="td-mono">${ lic.scriptType.code }</td>
                  <td class="td-mono">${ fmtDate(lic.expiresAt) }</td>
                  <td class="td-mono">${ days }</td>
                  <td class="td-mono" style="color:var(--c-accent)">${ lic.managementPin || '—' }</td>
                  <td><span class="badge badge-${ st }">${ label }</span></td>
                  <td><a href="/admin/licenses/${ lic.id }/edit" class="btn btn-ghost btn-sm">Edit</a></td>
                </tr>
              `;
            }).join('')
          }
        </tbody>
      </table>
    </div>

    ${ pagination.totalPages > 1 ? `
    <div class="pagination">
      ${ pagination.page > 1 ? `<a href="${ pageUrl(pagination.page - 1) }">← Prev</a>` : '' }
      <span>${ pagination.page } / ${ pagination.totalPages }</span>
      ${ pagination.page < pagination.totalPages ? `<a href="${ pageUrl(pagination.page + 1) }">Next →</a>` : '' }
    </div>
    ` : '' }
  `;
%>
<%- include('../../layouts/admin', { title, currentPage, admin, body }) %>
